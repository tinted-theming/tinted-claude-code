#!/usr/bin/env node
// tinted-claude-code — executable Claude Code theme (tinted8).
// Generated by tinted-builder-rust. Running it prints a Claude Code custom-theme
// JSON document to stdout:  node THIS_FILE > ~/.claude/themes/tinty.json
//
// Computes true "shimmer" variants by lightening/darkening each paired color,
// and decides dark-vs-light from the measured CIE L* of the foreground vs the
// background (the scheme's declared `variant` is not trusted).

// --- Non-shimmer overrides (rendered straight from the scheme) -----------------
const overrides = {
  text: "#{{ui.global.foreground.normal.hex}}",
  inverseText: "#{{ui.global.background.normal.hex}}",
  claude: "#{{ui.accent.normal.hex}}",
  inactive: "#{{palette.gray.normal.hex}}",
  subtle: "#{{ui.border.normal.hex}}",
  suggestion: "#{{palette.cyan.normal.hex}}",
  permission: "#{{palette.magenta.normal.hex}}",
  remember: "#{{palette.magenta.normal.hex}}",

  success: "#{{ui.status.success.hex}}",
  error: "#{{ui.status.error.hex}}",
  warning: "#{{ui.status.warning.hex}}",
  merged: "#{{palette.magenta.normal.hex}}",

  promptBorder: "#{{ui.border.normal.hex}}",
  planMode: "#{{palette.blue.normal.hex}}",
  autoAccept: "#{{palette.green.normal.hex}}",
  bashBorder: "#{{palette.magenta.normal.hex}}",
  ide: "#{{ui.status.info.hex}}",
  fastMode: "#{{palette.orange.normal.hex}}",

  userMessageBackground: "#{{ui.global.background.dark.hex}}",
  userMessageBackgroundHover: "#{{ui.chrome.background.normal.hex}}",
  messageActionsBackground: "#{{ui.chrome.background.normal.hex}}",
  bashMessageBackgroundColor: "#{{ui.global.background.dark.hex}}",
  memoryBackgroundColor: "#{{ui.global.background.dark.hex}}",
  selectionBg: "#{{ui.selection.background.hex}}",

  rate_limit_fill: "#{{ui.accent.normal.hex}}",
  rate_limit_empty: "#{{ui.global.background.dark.hex}}",
  briefLabelYou: "#{{palette.cyan.normal.hex}}",
  briefLabelClaude: "#{{ui.accent.normal.hex}}",

  red_FOR_SUBAGENTS_ONLY: "#{{palette.red.normal.hex}}",
  orange_FOR_SUBAGENTS_ONLY: "#{{palette.orange.normal.hex}}",
  yellow_FOR_SUBAGENTS_ONLY: "#{{palette.yellow.normal.hex}}",
  green_FOR_SUBAGENTS_ONLY: "#{{palette.green.normal.hex}}",
  cyan_FOR_SUBAGENTS_ONLY: "#{{palette.cyan.normal.hex}}",
  blue_FOR_SUBAGENTS_ONLY: "#{{palette.blue.normal.hex}}",
  purple_FOR_SUBAGENTS_ONLY: "#{{palette.magenta.normal.hex}}",
  pink_FOR_SUBAGENTS_ONLY: "#{{palette.magenta.bright.hex}}",

  rainbow_red: "#{{palette.red.normal.hex}}",
  rainbow_orange: "#{{palette.orange.normal.hex}}",
  rainbow_yellow: "#{{palette.yellow.normal.hex}}",
  rainbow_green: "#{{palette.green.normal.hex}}",
  rainbow_blue: "#{{palette.cyan.normal.hex}}",
  rainbow_indigo: "#{{palette.blue.normal.hex}}",
  rainbow_violet: "#{{palette.magenta.normal.hex}}",
};

const meta = {
  name: "{{scheme.name}}",
  foreground: "#{{ui.global.foreground.normal.hex}}",
  background: "#{{ui.global.background.normal.hex}}",
};

// --- Shimmer tokens: lighten (dark theme) / darken (light theme) a base color --
const SHIMMER = {
  claudeShimmer: "claude",
  warningShimmer: "warning",
  permissionShimmer: "permission",
  promptBorderShimmer: "promptBorder",
  inactiveShimmer: "inactive",
  fastModeShimmer: "fastMode",
  rainbow_red_shimmer: "rainbow_red",
  rainbow_orange_shimmer: "rainbow_orange",
  rainbow_yellow_shimmer: "rainbow_yellow",
  rainbow_green_shimmer: "rainbow_green",
  rainbow_blue_shimmer: "rainbow_blue",
  rainbow_indigo_shimmer: "rainbow_indigo",
  rainbow_violet_shimmer: "rainbow_violet",
};

// How far to push each shimmer toward white (dark) or black (light), 0..1.
const LIGHTEN = 0.30;
const DARKEN = 0.22;

// --- Color math ----------------------------------------------------------------
function parseHex(hex) {
  const h = hex.replace(/^#/, "");
  return [0, 2, 4].map((i) => parseInt(h.slice(i, i + 2), 16));
}
function toHex([r, g, b]) {
  const c = (n) => Math.max(0, Math.min(255, Math.round(n))).toString(16).padStart(2, "0");
  return "#" + c(r) + c(g) + c(b);
}
// sRGB channel -> linear light
function toLinear(c) {
  const x = c / 255;
  return x <= 0.04045 ? x / 12.92 : Math.pow((x + 0.055) / 1.055, 2.4);
}
// CIE L* (perceptual lightness, 0..100) from a hex color
function lstar(hex) {
  const [r, g, b] = parseHex(hex);
  const Y = 0.2126 * toLinear(r) + 0.7152 * toLinear(g) + 0.0722 * toLinear(b);
  return Y <= 216 / 24389 ? Y * (24389 / 27) : Math.pow(Y, 1 / 3) * 116 - 16;
}
// blend a color toward `target` (0 or 255) by fraction f
function blend(hex, target, f) {
  return toHex(parseHex(hex).map((c) => c + (target - c) * f));
}
// blend color `a` toward color `b` by fraction f (0 = a, 1 = b)
function mix(a, b, f) {
  const A = parseHex(a), B = parseHex(b);
  return toHex(A.map((c, i) => c + (B[i] - c) * f));
}

// --- Derive dark/light from measured lightness, not the declared variant -------
const isDark = lstar(meta.background) < lstar(meta.foreground);
const target = isDark ? 255 : 0;
const factor = isDark ? LIGHTEN : DARKEN;

for (const [token, src] of Object.entries(SHIMMER)) {
  overrides[token] = blend(overrides[src], target, factor);
}

// --- Diff backgrounds: tint the green/red hue into the editor background -------
// Needs color math, so it lives here (the static .json inherits Claude's
// out-of-the-box diff contrast instead). Higher fraction = closer to the
// background = subtler. Line < context is fainter; word-level is stronger.
const DIFF_LINE = isDark ? 0.85 : 0.80;
const DIFF_DIM = isDark ? 0.93 : 0.90;
const DIFF_WORD = isDark ? 0.68 : 0.62;
const bg = meta.background;
overrides.diffAdded = mix(overrides.success, bg, DIFF_LINE);
overrides.diffRemoved = mix(overrides.error, bg, DIFF_LINE);
overrides.diffAddedDimmed = mix(overrides.success, bg, DIFF_DIM);
overrides.diffRemovedDimmed = mix(overrides.error, bg, DIFF_DIM);
overrides.diffAddedWord = mix(overrides.success, bg, DIFF_WORD);
overrides.diffRemovedWord = mix(overrides.error, bg, DIFF_WORD);

const theme = { name: meta.name, base: isDark ? "dark" : "light", overrides };
process.stdout.write(JSON.stringify(theme, null, 2) + "\n");
